DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_NAME=db_name
DATABASE_PASS=
RABBITMQ_CONNECTION_STRING=amqp://guest:guest@localhost:5672/
# Used only by the Dockerized worker. Point at the shared broker on Docker Desktop.
WORKER_RABBITMQ_CONNECTION_STRING=amqp://guest:guest@host.docker.internal:5672/
# Server control-plane endpoint used only to obtain ephemeral clone credentials.
SERVER_INTERNAL_URL=http://host.docker.internal:8750
WORKER_INTERNAL_AUTH_TOKEN=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_ACCESS_KEY_SECRET=
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
APP_ENV=development
