FROM docker.io/library/golang:__GO_VERSION__-alpine AS builder

WORKDIR /app

ENV CGO_ENABLED=0 GOOS=linux GOTOOLCHAIN=local

COPY go.mod go.sum* ./
RUN go mod download

COPY . .
__GO_BUILD__

FROM docker.io/library/alpine:3.20

WORKDIR /app

RUN addgroup -S app && adduser -S app -G app

COPY --from=builder /app/app /app/app

USER app

EXPOSE 8080

CMD ["/app/app"]
