FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build
RUN test -f ./__OUTPUT_DIR__/index.html || (echo "ZERODEVOPS_SSR_MISMATCH: no index.html in __OUTPUT_DIR__ after npm run build" && exit 1)

FROM node:20-alpine AS runtime

WORKDIR /app

RUN npm install -g serve

COPY --from=builder /app/__OUTPUT_DIR__ ./__OUTPUT_DIR__

EXPOSE 4321

CMD ["serve", "__OUTPUT_DIR__", "-l", "4321"]
